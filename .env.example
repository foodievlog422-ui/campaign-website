# Copy to .env and fill in. NEVER commit the real .env.
PORT=3000
DB_PATH=./data/app.db
# Set true ONLY for local demo/testing (seeds 3 fake campaigns). Keep false in production.
SEED_DEMO=false
# Shared secret networks must send with every postback (header x-postback-secret or ?secret=)
POSTBACK_SECRET=change-me-to-a-long-random-string
# Optional: created automatically on first boot if set
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Optional generic JSON feed importer (server-side only)
NETWORK_FEED_URL=
NETWORK_FEED_TOKEN=
# Set true when running behind HTTPS
COOKIE_SECURE=false
