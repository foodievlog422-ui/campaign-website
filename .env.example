# Copy to .env and fill in. NEVER commit the real .env.
PORT=3000
# PRODUCTION (Render): set DATABASE_URL to the Supabase TRANSACTION POOLER
# connection string (Supabase Dashboard -> Project Settings -> Database ->
# Connection string -> Transaction pooler, port 6543). When set, the app uses
# Postgres with all tables in a dedicated schema named "campaign" (created
# automatically on boot) and DB_PATH/SQLite is ignored. REQUIRED on Render
# Free — its filesystem is ephemeral and a SQLite file would be wiped on
# every restart, losing wallet data.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Local dev only: SQLite file (used only when DATABASE_URL is empty).
DB_PATH=./data/app.db
# Set true ONLY for local demo/testing (seeds 3 fake campaigns). Keep false in production.
SEED_DEMO=false
# Shared secret networks must send with every postback (header x-postback-secret or ?secret=)
POSTBACK_SECRET=change-me-to-a-long-random-string
# Optional: created automatically on first boot if set
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Optional generic JSON feed importer (server-side only)
NETWORK_FEED_URL=
NETWORK_FEED_TOKEN=
# Set true when running behind HTTPS
COOKIE_SECURE=false
